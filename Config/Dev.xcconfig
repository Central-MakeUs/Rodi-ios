RODI_ANALYTICS_ENABLED = YES
CLARITY_ENABLED = YES
CLARITY_PROJECT_ID = xuel7v1h92
CLARITY_LOG_LEVEL = verbose
PRODUCT_BUNDLE_IDENTIFIER = com.dororong.rodi.dev
PRODUCT_DISPLAY_NAME = Rodi Dev
ASSETCATALOG_COMPILER_APPICON_NAME = AppIconDev
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
