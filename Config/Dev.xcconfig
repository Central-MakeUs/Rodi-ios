KAKAO_NATIVE_APP_KEY =
KAKAO_REST_API_KEY =
APP_STORE_APP_ID =

#include? "Secrets.dev.local.xcconfig"

RODI_ENVIRONMENT = dev
RODI_API_BASE_URL = https:/$()/api.stillstar.store
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1
